{
  "extraKnownMarketplaces": {
    "anti-slop": {
      "source": {
        "source": "github",
        "repo": "miqdadbadjuber/anti-slop"
      }
    }
  },
  "enabledPlugins": {
    "antislop@anti-slop": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run check:content)",
      "Bash(npm run build)",
      "Bash(npm run smoke)",
      "Bash(npm run verify)",
      "Bash(node scripts/check-content.mjs:*)",
      "Bash(node scripts/smoke.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-content.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
