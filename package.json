{
  "name": "personalweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:content && npm run lint",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && NEXT_DIST_DIR=.next-verify next build && NEXT_DIST_DIR=.next-verify node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "^15.5.15",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4.0.1",
    "remark-smartypants": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^15.4.6",
    "js-yaml": "^4.1.1",
    "tailwindcss": "^4"
  }
}
